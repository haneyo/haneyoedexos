#cloud-config
# eDEX-OS autoinstall — keeps the key steps interactive (like installing stock
# Ubuntu: locale / network / storage / identity), automates everything else and
# installs eDEX as the whole desktop shell via late-commands.
#
# Files this relies on, all on the ISO under /cdrom/nocloud/:
#   install-edex.sh       the target-setup script (runs inside the installed chroot)
#   eDEX-UI.AppImage      the eDEX-UI AppImage (built by the CI pipeline)
autoinstall:
  version: 1
  # Fully OFFLINE install: the GUI stack + eDEX are baked into the squashfs, so
  # no network and no update download is needed. Only locale / storage / user
  # stay interactive (like stock Ubuntu).
  interactive-sections:
    - locale
    - storage
    - identity
  updates: none
  late-commands:
    - cp /cdrom/nocloud/install-edex.sh /target/root/install-edex.sh
    - curtin in-target --target=/target -- bash /root/install-edex.sh
