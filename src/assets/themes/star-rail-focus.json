        "green": "#5ae0a0",
        "yellow": "#f29e38",
        "blue": "#48c0f8",
        "magenta": "#d850f8",
        "cyan": "#58d8f0",
        "white": "#d8d5ef",
        "brightBlack": "#4a4a70",
        "brightRed": "#f06a6a",
        "brightGreen": "#7af0c0",
        "brightYellow": "#ffb868",
        "brightBlue": "#68d0ff",
